{
  "version": "1.0.0",
  "services": [
    {
      "name": "student-registry-db",
      "type": "docker",
      "image": "mysql:8.0",
      "environment": {
        "MYSQL_DATABASE": "StudentRegistrationDB",
        "MYSQL_ROOT_PASSWORD": "${DB_PASSWORD}",
        "MYSQL_USER": "root"
      },
      "ports": ["3306:3306"],
      "volumes": ["db_data:/var/lib/mysql"]
    },
    {
      "name": "student-registry-backend",
      "type": "docker",
      "build": {
        "context": "./backend",
        "dockerfile": "Dockerfile"
      },
      "environment": {
        "DB_SERVER": "student-registry-db",
        "DB_PORT": "3306",
        "DB_NAME": "StudentRegistrationDB",
        "DB_USER": "root",
        "DB_PASSWORD": "${DB_PASSWORD}",
        "ASPNETCORE_ENVIRONMENT": "Production",
        "ASPNETCORE_URLS": "http://+:8080"
      },
      "ports": ["8080:8080"],
      "depends_on": ["student-registry-db"]
    },
    {
      "name": "student-registry-frontend",
      "type": "docker",
      "build": {
        "context": "./frontend",
        "dockerfile": "Dockerfile"
      },
      "environment": {
        "API_URL": "http://student-registry-backend:8080"
      },
      "ports": ["4200:4200"],
      "depends_on": ["student-registry-backend"]
    }
  ],
  "volumes": {
    "db_data": {
      "driver": "local"
    }
  }
}
