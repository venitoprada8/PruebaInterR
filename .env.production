# Production Environment Variables
# IMPORTANTE: En Dockploy, define estas variables en los secrets del proyecto

# Database Configuration
DB_SERVER=student-registry-db
DB_PORT=3306
DB_NAME=StudentRegistrationDB
DB_USER=root
DB_PASSWORD=changeme_in_dockploy

# Backend Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Frontend Configuration
API_URL=http://student-registry-backend:8080
NODE_ENV=production
