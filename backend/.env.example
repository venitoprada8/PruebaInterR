# Database Configuration
# Copy this file to .env and fill in your environment-specific values

# Database Server
DB_SERVER=

# Database Port
DB_PORT=3306

# Database Name
DB_NAME=StudentRegistrationDB

# Database User
DB_USER=root

# Database Password
DB_PASSWORD=toor

# Example for Production:
# DB_SERVER=prod-mysql.miempresa.com
# DB_PORT=3306
# DB_NAME=StudentDB_Production
# DB_USER=sqluser
# DB_PASSWORD=SecurePassword123!SecurePassword123!

# Example for Staging:
# DB_SERVER=staging-mysql.miempresa.com
# DB_PORT=3306
# DB_NAME=StudentDB_Staging
# DB_USER=sqluser
# DB_PASSWORD=StagingPassword123!
